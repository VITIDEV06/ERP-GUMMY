# =========================================================
# GUMMY ERP - .gitignore
# =========================================================

# ---------- Entornos virtuales ----------
venv/
.venv/
env/
ENV/
.python-version

# ---------- Python: bytecode y cache ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- Herramientas de pruebas y analisis ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---------- Empaquetado y builds (incluye `flet build`) ----------
build/
dist/
*.egg-info/
.eggs/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Variables de entorno y secretos ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---------- Bases de datos locales de desarrollo ----------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------- Logs y archivos temporales ----------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~

# ---------- IDE y editores ----------
.vscode/
.idea/
*.code-workspace
.claude/settings.local.json

# ---------- Sistema operativo ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# NOTA: las imagenes de assets/ (Logo.png, imagen-login.png) y Banner.png
# SI se versionan. No agregar reglas que excluyan *.png ni assets/.
